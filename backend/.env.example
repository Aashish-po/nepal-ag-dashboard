# Backend environment variables — copy to .env.local and fill in.
# .env.local is git-ignored. Do NOT commit real secrets.

# --- Database (required in production) ---
# Local dev default is used if unset. In production use the Supabase POOLED
# connection string (port 6543, pgBouncer) so Render's many short-lived
# connections don't exhaust Postgres.
DATABASE_URL=postgresql://user:password@localhost:5432/nepal_ag_dev

# Log every SQL statement (noisy; dev only). true/1 to enable.
SQLALCHEMY_ECHO=false

# --- Runtime mode: development | testing | production ---
# development: creates tables on startup.
# production:  starts the APScheduler ETL AND requires CORS_ORIGINS to be
#              explicit and wildcard-free (the app raises RuntimeError otherwise).
ENVIRONMENT=development

# --- CORS ---
# Comma-separated, no spaces, no wildcards in production.
# Must include the deployed frontend origin, e.g. https://<app>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis cache (optional) ---
# Unset -> cache layer no-ops (graceful degradation). In production use the
# Upstash rediss:// URL.
REDIS_URL=redis://localhost:6379/0

# --- ETL data directory ---
# Where committed CSV fallbacks live. Relative to the backend/ working dir.
DATA_DIR=./data

# --- Reserved / NOT yet wired in code ---
# SENTRY_DSN is declared in render.yaml but no code reads it yet. Wiring
# sentry-sdk is a separate task — see DEPLOYMENT.md ("Monitoring").
# SENTRY_DSN=

# PORT is provided by the host (Render sets $PORT); only set locally to override.
# PORT=8000
