# Nepal Agricultural Intelligence Dashboard — Environment Configuration
#
# This is the root-level env template covering both backend and frontend.
# Copy it to .env for each layer:
#
#   cp .env.example backend/.env.local    # backend env
#   cp .env.example frontend/.env.local    # frontend env
#
# Then edit the copied file. Only keep the vars relevant to that layer.
# .env.local and .env are git-ignored — never commit real secrets.
#
# ─────────────────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════════════════
# Backend — set in Render → Environment (production)
# Local dev: copy to backend/.env.local
# ════════════════════════════════════════════════════════════════════════════

# --- Database (required in production) ──────────────────────────────────────
# Local dev default (SQLite or local Postgres) is used if unset.
# In production, use the SUPABASE POOLED connection string (port 6543,
# pgBouncer) so Render's many short-lived connections don't exhaust Postgres.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Log every SQL statement (noisy; dev only). true/1 to enable.
SQLALCHEMY_ECHO=false

# --- Runtime mode ──────────────────────────────────────────────────────────
# development: creates tables on startup.
# production:  starts the APScheduler ETL + requires CORS_ORIGINS to be
#              explicit and wildcard-free (app raises RuntimeError otherwise).
# testing:    set by conftest.py; no DATABASE_URL — tests use fixtures.
ENVIRONMENT=development

# --- CORS ──────────────────────────────────────────────────────────────────
# Comma-separated, no spaces, no wildcards in production.
# Must include the deployed frontend origin, e.g. https://<app>.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- ETL data directory ────────────────────────────────────────────────────
# Where committed CSV fallbacks live. Relative to the backend/ working dir.
DATA_DIR=./data

# --- Redis (optional) ──────────────────────────────────────────────────────
# Unset → cache no-ops (app still works, requests recompute).
REDIS_URL=

# --- Sentry (optional) ────────────────────────────────────────────────────
# Placeholder only — no code imports sentry-sdk yet. See plans/DEPLOYMENT.md Part 9.
SENTRY_DSN=

# --- Host / port (local dev override) ─────────────────────────────────────
# In production, Render provides $PORT automatically.
API_HOST=0.0.0.0
API_PORT=8000

# ════════════════════════════════════════════════════════════════════════════
# Frontend — set in Vercel → Settings → Environment Variables (production)
# Local dev: copy to frontend/.env.local
# ════════════════════════════════════════════════════════════════════════════

# API base URL the frontend calls.
# Local dev:    http://localhost:8000
# Production:   https://nepal-ag-backend.onrender.com
# IMPORTANT: no trailing slash. This is captured at BUILD TIME — redeploy
# the frontend after changing it.
VITE_API_BASE_URL=http://localhost:8000
