# Frontend environment variables — copy to .env.local and fill in.
# Vite auto-loads .env and .env.local at build/dev time (no extra config needed).
# .env.local is git-ignored. Do NOT commit real secrets.
# NEVER copy .env.example directly — always create .env.local:
#   cp frontend/.env.example frontend/.env.local

# API base URL the frontend calls.
# Local dev:    http://localhost:8000
# Production:   https://nepal-ag-backend.onrender.com
# IMPORTANT: no trailing slash. This is captured at BUILD TIME — redeploy
# the frontend after changing it.
VITE_API_BASE_URL=http://localhost:8000
